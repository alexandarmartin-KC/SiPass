{
  "ConnectionStrings": {
    "Default": "Data Source=sipass-health.db"
  },
  "Sipass": {
    "BaseUrl": "https://sipass.local",
    "Operator": "",
    "Password": "",
    "VerifyTls": true,
    "RenewIntervalSeconds": 90
  },
  "StateEngine": {
    "Controller": {
      "UnstableSeconds": 120,
      "OfflineSeconds": 180,
      "StableOnlineSeconds": 60
    },
    "AccessPoint": {
      "UnstableSeconds": 180,
      "OfflineSeconds": 300,
      "StableOnlineSeconds": 90
    },
    "FlapCountThreshold24h": 6,
    "TickSeconds": 10
  },
  "Retention": {
    "EventDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
